{
  "dataloader": {
    "dataset_name": "retrieval_as_user",
    "mode": "msmarco_query",
    "path": "./data/msmarco_trec_dl",
    "benchmark": "trec-dl-2019",
    "candidate_limit": 1000,
    "qrels_min_relevance": 2,

    "top_k": 1000,
    "seed": 42,

    "flush_every": 250000,
    "progress_every": 10,

    "bm25_config": {
      "index_name": "bm25_index_msmarco_rau",
      "model": "bm25",
      "query_col": "search_query",
      "doc_col": "document",
      "doc_id_col": "document_id",
      "hyperparams": { "b": 0.75, "k1": 1.5 }
    }
  }
}
