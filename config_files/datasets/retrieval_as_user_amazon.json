{
  "dataloader": {
    "dataset_name": "retrieval_as_user",
    "mode": "amazon_category",
    "path": "amazonElectronics",

    "top_k": 100,
    "seed": 42,
    "query_limit": 20000,

    "amazon_meta_url": "https://mcauleylab.ucsd.edu/public_datasets/data/amazon_v2/metaFiles2/meta_Electronics.json.gz",
    "amazon_meta_file": "meta_Electronics.json.gz",
    "amazon_max_products": 200000,
    "amazon_cache_pairs": "amazon_search_pairs.parquet",
    "amazon_min_cat_len": 3,
    "amazon_min_docs_per_query": 10,

    "bm25_config": {
      "index_name": "bm25_index_amazon_rau",
      "model": "bm25",
      "query_col": "search_query",
      "doc_col": "document",
      "doc_id_col": "document_id",
      "hyperparams": { "b": 0.75, "k1": 1.5 }
    }
  }
}
