{
  "dataloader": {
    "dataset_name": "retrieval_as_user",
    "mode": "hybrid",
    "path": "data/hybrid_dataset/hybrid_dataset",
    "min_grade": null,
    "target_mode": "new",
    "top_k": 100,
    "seed": 42,
    "query_limit": null,
    "label_mode": "binary",
    "num_folds": 3,
    "progress_every": 500,
    "context_users_frac": 0.0,
    "context_min_rating": null,
    "bm25_config": {
      "index_name": "bm25_index_hybrid_rau",
      "model": "bm25",
      "query_col": "search_query",
      "doc_col": "document",
      "doc_id_col": "document_id",
      "hyperparams": {
        "b": 0.75,
        "k1": 1.5
      }
    }
  }
}
