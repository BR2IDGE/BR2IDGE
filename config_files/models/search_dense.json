{
    "dataloader": {
        "dataset_name": "movielens",
        "test_size": 0.15,
        "val_size": 0.15,
        "seed": 42
    },
    "model": {
        "model_type": "DenseRetrieverModel",
        "parameters": {
            "retriever_params": {
                "normalize": true,
                "max_length": 256,
                "use_ann": false
            },
            "index_params": {
                "use_gpu": false,
                "batch_size": 512,
                "show_progress": true
            }
        }
    },
    "evaluation": {
        "metrics": [
            "NDCG",
            "MAP",
            "MRR",
            "PRECISION",
            "RECALL"
        ],
        "top_ks": [
            1,
            3,
            5,
            10
        ]
    }
}