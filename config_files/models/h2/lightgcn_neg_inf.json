{
  "model": {
    "model_type": "LightGCNModel",
    "model_name": "lightgcn_h2_neg_inf",
    "parameters": {
      "embedding_dim": 32,
      "n_layers": 2,
      "epochs": 60,
      "learning_rate": 0.01,
      "reg_weight": 0.0001,
      "batch_size": 4096,
      "seed": 42,
      "positive_threshold": 0.0,
      "as_binary": true,
      "cold_start_score": "neg_inf",
      "verbose": true,
      "print_every": 10
    }
  },
  "evaluation": {
    "evaluator": "EvaluatorRecsManager",
    "metrics": [
      "NDCG",
      "MAP",
      "MRR",
      "PRECISION",
      "RECALL"
    ],
    "top_ks": [
      1,
      5,
      10,
      20,
      30,
      50
    ]
  }
}
