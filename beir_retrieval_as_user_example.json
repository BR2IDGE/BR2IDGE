{
  "experiment_name": "BEIR_RetrievalAsUser_Recs",
  "task_type": "recs",
  "hybrid": true,
  "hybridStrategie": "retrieval-as-user",
  "output_dir": "artifacts",
  "dataset": {
    "name": "beir_nfcorpus"
  },
  "model": [
    {
      "name": "ItemKNNModel"
    }
  ],
  "execution": {
    "force": [
      "preprocess",
      "features",
      "train",
      "eval"
    ],
    "skip": [],
    "no_save": [],
    "n_runs": 1
  },
  "evaluation": {
    "n_pos_samples": 20,
    "n_neg_samples": 200,
    "top_ks": [
      5,
      10,
      20,
      50
    ],
    "metrics": [
      "NDCG",
      "PRECISION",
      "RECALL"
    ]
  }
}
