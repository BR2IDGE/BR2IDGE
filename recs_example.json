{
  "experiment_name": "Recs_experiment",
  "task_type": "recs",
  "output_dir": "artifacts",

  "dataset": {
    "name": "MovieLens"
  },

  "model":[ 
    {
      "name": "Bert4REC"
    },
    {
      "name": "DeepFMModel"  
    }
  ],

  "execution": {
    "force": ["preprocess", "features", "eval", "train"],
    "skip": [],
    "no_save": [],
    "n_runs": 1,
    "window_size": 0.05
  },
  
  "evaluation": {
    "n_pos_samples": 20,  
    "n_neg_samples": 200,
    "top_ks": [5, 10, 20, 50],
    "metrics": ["NDCG", "RECALL", "PRECISION"],
    "stats": {
      "tests": [],
      "alpha": 0.05,
      "symbol": "▲"
    }
  }
}